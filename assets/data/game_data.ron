// Bloom & Gather — game content and balancing.
//
// This file is the single source of truth for every price, requirement and
// count in the game. It is compiled into the binary and validated at startup
// and by `cargo test -p bloom_core` (see docs/economy-balancing.md for the
// invariants). Colours are sRGB (r, g, b) in 0–255.
(
    version: 1,

    economy: (
        // Every flower, of every species and rarity, sells for exactly this.
        flower_base_value: 10,
        starting_coins: 0,
        base_craft_batch_capacity: 5,
        upgrade_cost_growth: 1.6,
    ),

    progression: (
        xp_per_harvest: 3,
        xp_per_discovery: 25,
        xp_per_craft_base: 4,
        xp_per_craft_tier: 2,
        xp_first_craft: 50,
        xp_region_complete: 150,
        skill_points_per_level: 1,
        // Discovering this many species earns +1 skill point each.
        collection_milestones: [8, 16],
        // XP from level L to L+1 = base + step * (L - 1)
        level_curve: (base: 30, step: 20, max_level: 30),
    ),

    // Distances in metres, times in seconds. Tool effects below set each
    // mode's reach; these are the pauses between uses.
    harvesting: (
        hand_cooldown_secs: 0.35,
        radius_cooldown_secs: 0.7,
        sweep_interval_secs: 0.25,
        area_cooldown_secs: 1.5,
        // How far beyond the flower reach the ground can be targeted.
        ground_reach_bonus: 1.5,
    ),

    // All world distances are in metres.
    world: (
        chunk_size: 32.0,
        min_flower_spacing: 1.4,
        terrain_cell: 0.5,
        // Flowers are drawn (and picked) larger than life so they read well
        // from eye height; species heights below are botanical sizes.
        flower_scale: 2.2,
        boundary_margin: 4.0,
    ),

    player: (
        radius: 0.35,
        height: 1.75,
        eye_height: 1.62,
        walk_speed: 4.2,
        sprint_speed: 6.8,
        ground_accel: 38.0,
        ground_decel: 30.0,
        air_accel: 7.0,
        gravity: 22.0,
        jump_height: 1.05,
        max_slope_deg: 42.0,
        step_height: 0.35,
        ground_snap: 0.45,
        coyote_secs: 0.10,
        jump_buffer_secs: 0.12,
        interact_range: 3.0,
    ),

    // `shape` picks the 3D silhouette family, `height` is the bloom height in
    // metres (also used for look-at picking), `glow` lights up night flowers.
    species: [
        (id: "daisy",         name: "Daisy",         rarity: Common,   shape: Daisy,      height: 0.32,
         petal_color: (250, 247, 238), center_color: (240, 200,  90),
         description: "A cheerful meadow staple that opens with the morning sun."),
        (id: "daffodil",      name: "Daffodil",      rarity: Common,   shape: Trumpet,    height: 0.42,
         petal_color: (246, 224, 128), center_color: (238, 168,  72),
         description: "A sunny trumpet that nods politely to anyone passing by."),
        (id: "poppy",         name: "Poppy",         rarity: Uncommon, shape: Cup,        height: 0.50,
         petal_color: (226, 120, 104), center_color: ( 70,  52,  50),
         description: "Papery coral petals that sway at the slightest breeze."),
        (id: "bluebell",      name: "Bluebell",      rarity: Uncommon, shape: Bells,      height: 0.30,
         petal_color: (128, 150, 216), center_color: ( 96, 116, 190),
         description: "Arching stems hung with tiny bells that never quite ring."),
        (id: "meadow_clover", name: "Meadow Clover", rarity: Uncommon, shape: Pompom,     height: 0.16,
         petal_color: (226, 160, 196), center_color: (196, 116, 166),
         description: "A humble wildflower pompom, beloved by every bee in the meadow."),
        (id: "lavender",      name: "Lavender",      rarity: Common,   shape: Spike,      height: 0.60,
         petal_color: (170, 146, 206), center_color: (130, 105, 170),
         description: "Fragrant spikes that fill the air with a calm, sweet scent."),
        (id: "tulip",         name: "Tulip",         rarity: Common,   shape: Tulip,      height: 0.42,
         petal_color: (238, 150, 160), center_color: (220, 190, 110),
         description: "Soft rosy cups that close up neatly every evening."),
        (id: "sunflower",     name: "Sunflower",     rarity: Uncommon, shape: Sunflower,  height: 1.35,
         petal_color: (240, 196,  80), center_color: (120,  85,  50),
         description: "A tall, friendly face that follows the sun across the sky."),
        (id: "rose",          name: "Rose",          rarity: Uncommon, shape: Rose,       height: 0.55,
         petal_color: (214, 104, 120), center_color: (170,  70,  90),
         description: "Layered velvet petals, the heart of every romantic bouquet."),
        (id: "peony",         name: "Peony",         rarity: Uncommon, shape: Ruffle,     height: 0.55,
         petal_color: (244, 184, 196), center_color: (236, 150, 170),
         description: "Lush, ruffled blooms as round and soft as a cloud."),
        (id: "hydrangea",     name: "Hydrangea",     rarity: Rare,     shape: Mophead,    height: 0.70,
         petal_color: (176, 188, 228), center_color: (214, 176, 216),
         description: "A mophead of tiny florets that blushes blue or pink with the soil."),
        (id: "foxglove",      name: "Foxglove",      rarity: Common,   shape: Foxglove,   height: 0.95,
         petal_color: (196, 130, 190), center_color: (240, 220, 236),
         description: "Freckled bells stacked along tall stems in shady glades."),
        (id: "wild_orchid",   name: "Wild Orchid",   rarity: Rare,     shape: Orchid,     height: 0.48,
         petal_color: (206, 160, 222), center_color: (250, 236, 170),
         description: "A delicate forest orchid that hides among mossy roots."),
        (id: "fairy_lily",    name: "Fairy Lily",    rarity: VeryRare, shape: Lily,       height: 0.62, glow: 0.35,
         petal_color: (220, 240, 236), center_color: (170, 230, 214),
         description: "Said to bloom only where fireflies gather at dusk."),
        (id: "night_jasmine", name: "Night Jasmine", rarity: Common,   shape: StarCluster, height: 0.42, glow: 0.15,
         petal_color: (246, 244, 232), center_color: (214, 226, 160),
         description: "Tiny starry flowers whose perfume drifts after dark."),
        (id: "moonflower",    name: "Moonflower",    rarity: Rare,     shape: Moonbloom,  height: 0.48, glow: 0.5,
         petal_color: (226, 232, 250), center_color: (180, 200, 240),
         description: "A wide pale trumpet that unfurls beneath the moon."),
        (id: "starpetal",     name: "Starpetal",     rarity: VeryRare, shape: Star,       height: 0.36, glow: 0.8,
         petal_color: (200, 220, 255), center_color: (255, 246, 200),
         description: "A faintly glowing five-pointed bloom. Very few exist."),
    ],

    tools: [
        (id: "binding_ribbon", name: "Flower Binding Ribbon", category: Crafting, price: 100, unlock_level: 2,
         description: "A spool of soft linen ribbon. Lets you tie your first simple bouquets.",
         effects: [], icon_color: (238, 190, 190)),
        (id: "garden_scissors", name: "Garden Scissors", category: Both, price: 300, unlock_level: 3,
         description: "Sharp little snips: pick faster and trim stems for colourful bouquets.",
         effects: [HarvestCooldownMultiplier(0.6)], icon_color: (180, 190, 200)),
        (id: "harvesting_basket", name: "Harvesting Basket", category: Harvesting, price: 600, unlock_level: 5,
         description: "A wide wicker basket. Gather every flower in a small circle at once.",
         effects: [RadiusMode(radius: 1.6, max_flowers: 6)], icon_color: (196, 160, 110)),
        (id: "florist_knife", name: "Florist Knife", category: Crafting, price: 1000, unlock_level: 7,
         description: "A curved blade for clean angled cuts. Opens special arrangements.",
         effects: [], icon_color: (150, 130, 110)),
        (id: "wrapping_paper_set", name: "Wrapping Paper Set", category: Crafting, price: 1500, unlock_level: 9,
         description: "Kraft paper, tissue and twine for wrapped, higher-value bouquets.",
         effects: [], icon_color: (226, 200, 160)),
        (id: "pro_gardening_tools", name: "Professional Gardening Tools", category: Harvesting, price: 2000, unlock_level: 11,
         description: "A sturdy tool roll. Hold and sweep to gather flowers as you go.",
         requires_tools: ["harvesting_basket"],
         effects: [SweepMode(radius: 2.2, max_flowers_per_tick: 4)], icon_color: (130, 150, 110)),
        (id: "florist_workbench", name: "Florist Workbench", category: Crafting, price: 2600, unlock_level: 12,
         description: "A proper bench with buckets and twine. Bigger batches, finer arrangements.",
         effects: [CraftBatchCapacity(25)], icon_color: (170, 130, 90)),
        (id: "advanced_harvesting_equipment", name: "Advanced Harvesting Equipment", category: Harvesting, price: 3200, unlock_level: 14,
         description: "A flower cart with wide rakes. Mark out a whole area and gather it.",
         requires_tools: ["pro_gardening_tools"],
         effects: [AreaMode(max_width: 8.0, max_height: 8.0, max_flowers: 40)], icon_color: (120, 140, 160)),
        (id: "pro_florist_set", name: "Professional Florist Set", category: Crafting, price: 4000, unlock_level: 16,
         description: "Everything a master florist needs, for the most exquisite arrangements.",
         requires_tools: ["florist_workbench"],
         effects: [CraftBatchCapacity(50)], icon_color: (200, 170, 210)),
    ],

    recipes: [
        (id: "simple_bouquet", name: "Simple Bouquet", tier: 1, flower_count: 3, sell_price: 45, craft_time_secs: 0.5,
         description: "Three flowers tied with ribbon. Humble, but it sells.",
         required_tools: ["binding_ribbon"], ribbon_color: (238, 190, 190)),
        (id: "colorful_bouquet", name: "Colorful Bouquet", tier: 2, flower_count: 5, min_distinct_species: 3, sell_price: 90, craft_time_secs: 0.8,
         description: "A cheerful mix of at least three different species.",
         required_tools: ["binding_ribbon", "garden_scissors"], ribbon_color: (232, 212, 140)),
        (id: "romantic_bouquet", name: "Romantic Bouquet", tier: 3, flower_count: 7, sell_price: 150, craft_time_secs: 1.2,
         description: "Roses at its heart, softened with whatever else you love.",
         required_species: [(species: "rose", count: 2)],
         required_tools: ["binding_ribbon", "florist_knife"], ribbon_color: (214, 104, 120)),
        (id: "wrapped_garden_bouquet", name: "Wrapped Garden Bouquet", tier: 4, flower_count: 8, min_distinct_species: 4, sell_price: 190, craft_time_secs: 1.5,
         description: "A generous garden mix wrapped in kraft paper and twine.",
         required_tools: ["binding_ribbon", "wrapping_paper_set"], ribbon_color: (196, 160, 110)),
        (id: "woodland_arrangement", name: "Woodland Arrangement", tier: 5, flower_count: 9, sell_price: 230, craft_time_secs: 1.8,
         description: "Foxgloves and a wild orchid, arranged like a forest floor.",
         required_species: [(species: "foxglove", count: 2), (species: "wild_orchid", count: 1)],
         required_tools: ["florist_knife", "florist_workbench"], ribbon_color: (130, 150, 110)),
        (id: "premium_bouquet", name: "Premium Bouquet", tier: 6, flower_count: 10, min_distinct_species: 5, sell_price: 270, craft_time_secs: 2.2,
         description: "Ten flowers from five species, balanced by a professional eye.",
         required_tools: ["pro_florist_set"], ribbon_color: (190, 172, 214)),
        (id: "moonlit_bouquet", name: "Moonlit Bouquet", tier: 7, flower_count: 12, sell_price: 340, craft_time_secs: 2.6,
         description: "Pale moonflowers and night jasmine wrapped in midnight tissue.",
         required_species: [(species: "moonflower", count: 3), (species: "night_jasmine", count: 2)],
         required_tools: ["wrapping_paper_set", "pro_florist_set"], ribbon_color: (180, 200, 240)),
        (id: "royal_bouquet", name: "Royal Bouquet", tier: 8, flower_count: 15, sell_price: 450, craft_time_secs: 3.0,
         description: "The rarest blooms of the farm: a hydrangea, a fairy lily and a starpetal.",
         required_species: [(species: "hydrangea", count: 1), (species: "fairy_lily", count: 1), (species: "starpetal", count: 1)],
         required_tools: ["pro_florist_set"], ribbon_color: (246, 214, 120)),
    ],

    // One map: a flat bulb farm. Long beds of one colour each run north
    // from the farmyard on both sides of a straight track; wildflowers grow
    // on the verges, a few rare strays hide among the beds, and the sun
    // rises and sets over it all.
    regions: [
        (id: "tulip_fields", name: "Tulip Fields", flower_total: 1900, width: 52.0, depth: 88.0, seed: 7101,
         description: "Stripes of colour to the horizon on a flat polder, from sunrise to starlight.",
         flowers: [
            // In beds, shortest next to the track, tallest at the back.
            (species: "bluebell", count: 55), (species: "daffodil", count: 80), (species: "tulip", count: 275),
            (species: "night_jasmine", count: 150), (species: "moonflower", count: 180),
            (species: "wild_orchid", count: 140), (species: "rose", count: 200), (species: "peony", count: 155),
            (species: "lavender", count: 160), (species: "hydrangea", count: 70), (species: "foxglove", count: 180),
            (species: "sunflower", count: 70),
            // Strays among the beds.
            (species: "fairy_lily", count: 55), (species: "starpetal", count: 40),
            // Wild on the verges and in the farmyard.
            (species: "daisy", count: 45), (species: "meadow_clover", count: 10), (species: "poppy", count: 35),
         ],
         unlock: (level: 1, flowers_harvested: 0),
         completion_reward: (coins: 500, skill_points: 2),
         palette: (sky: (208, 228, 248), ground: (128, 170, 84), ground_dark: (98, 140, 64),
                   ground_light: (160, 196, 104), path: (216, 192, 150), accent: (236, 110, 160)),
         terrain: (amplitude: 0.25, feature_size: 70.0, octaves: 2, border_rise: 0.5, border_width: 6.0),
         props: (trees: 6, rocks: 0),
         workshop: true,
         scenery: (entrance: FarmGate, ambience: Meadow,
                   // The light at noon; the day cycle colours dawn, dusk and night.
                   atmosphere: (sun_color: (255, 244, 222), sun_illuminance: 4200.0, sun_elevation_deg: 55.0,
                                ambient_color: (222, 232, 255), ambient_brightness: 430.0,
                                zenith: Some((86, 146, 226)), fog_start: 1.4, fog_end: 5.0),
                   features: (fields: Some((bed_width: 1.2, furrow_width: 0.7, lines: 2, yard_depth: 24.0,
                                            verge: 3.0, headland: 3.0,
                                            verge_species: ["daisy", "meadow_clover", "poppy"],
                                            stray_species: ["fairy_lily", "starpetal"])),
                              lanterns: 14, fireflies: 40, grass_density: Some(0.8)),
                   day_cycle: Some((day_length_secs: 960.0, start_hour: 7.5)))),
    ],

    // Coin-priced, levelled upgrades sold at the workshop's tool shelf.
    // Level n costs base_price x upgrade_cost_growth^n (before discounts).
    // Effect values are per level. No upgrade touches the price of flowers.
    upgrades: [
        (id: "nimble_hands", name: "Nimble Hands", category: Harvesting, base_price: 80, max_level: 5,
         description: "Practised fingers: less time between single picks.",
         effects: [PickCooldown(0.06)]),
        (id: "wider_reach", name: "Wider Reach", category: Harvesting, base_price: 150, max_level: 5,
         description: "A wider basket rim and rake: gather from a bigger circle.",
         requires_tool: Some("harvesting_basket"),
         effects: [GatherRadius(0.10)]),
        (id: "deep_basket", name: "Deep Basket", category: Harvesting, base_price: 150, max_level: 5,
         description: "Room for more: every basket, rake and cart action gathers more flowers.",
         requires_tool: Some("harvesting_basket"),
         effects: [GatherCapacity(0.20)]),
        (id: "wide_rakes", name: "Wide Rakes", category: Harvesting, base_price: 400, max_level: 3,
         description: "Longer cart rakes: mark out a bigger area.",
         requires_tool: Some("advanced_harvesting_equipment"),
         effects: [AreaSize(0.10)]),
        (id: "quick_binding", name: "Quick Binding", category: Crafting, base_price: 100, max_level: 5,
         description: "A tidier bench: bouquets bind faster.",
         requires_tool: Some("binding_ribbon"),
         effects: [CraftTime(0.08)]),
        (id: "bulk_orders", name: "Bulk Orders", category: Crafting, base_price: 200, max_level: 4,
         description: "More buckets and twine: bind more bouquets at once.",
         requires_tool: Some("binding_ribbon"),
         effects: [BatchCapacity(5)]),
        (id: "garden_boots", name: "Garden Boots", category: Exploration, base_price: 250, max_level: 4,
         description: "Light, sturdy boots: walk and run faster.",
         effects: [MoveSpeed(0.04)]),
        (id: "market_stall", name: "Market Stall", category: Economy, base_price: 150, max_level: 5,
         description: "A proper stall to show them off: every bouquet sells for more.",
         requires_tool: Some("binding_ribbon"),
         effects: [BouquetPrice(0.04)]),
        (id: "haggler", name: "Haggler", category: Economy, base_price: 120, max_level: 5,
         description: "A friendly word with the toolmaker: tools cost less.",
         effects: [ToolDiscount(0.03)]),
        (id: "pretty_packaging", name: "Pretty Packaging", category: Economy, base_price: 300, max_level: 3,
         description: "Ribbons and tissue to match: wrapped bouquets sell for more.",
         requires_tool: Some("wrapping_paper_set"),
         effects: [BouquetPriceWithTool(tool: "wrapping_paper_set", bonus: 0.06)]),
    ],

    // The skill tree: five branches, each a chain (a skill needs the one
    // before it). Skill points come from levels, clearing the farm and
    // collection milestones. Skills never grant tools, modes or recipes.
    skills: [
        // Harvesting
        (id: "quick_fingers", name: "Quick Fingers", branch: Harvesting, max_level: 3, cost: 1,
         description: "Pick single flowers a little faster.",
         effects: [PickCooldown(0.05)]),
        (id: "double_harvest", name: "Double Harvest", branch: Harvesting, max_level: 3, cost: 1,
         requires_skill: Some("quick_fingers"),
         description: "A chance that picking one flower also picks its nearest neighbour.",
         effects: [DoubleHarvest(0.08)]),
        (id: "improved_radius", name: "Improved Radius", branch: Harvesting, max_level: 3, cost: 1,
         requires_skill: Some("double_harvest"), requires_tool: Some("harvesting_basket"),
         description: "Basket and rake reach a wider circle.",
         effects: [GatherRadius(0.08)]),
        (id: "master_picker", name: "Master Picker", branch: Harvesting, max_level: 1, cost: 2,
         requires_skill: Some("improved_radius"), requires_tool: Some("pro_gardening_tools"),
         description: "Every basket, rake and cart action gathers a quarter more.",
         effects: [GatherCapacity(0.25)]),
        // Botany
        (id: "botanical_knowledge", name: "Botanical Knowledge", branch: Botany, max_level: 2, cost: 1,
         description: "More XP for every new species you discover.",
         effects: [DiscoveryXp(0.15)]),
        (id: "flower_recognition", name: "Flower Recognition", branch: Botany, max_level: 1, cost: 1,
         requires_skill: Some("botanical_knowledge"),
         description: "Flowers of species you haven't discovered yet sparkle in the field.",
         effects: [RevealUndiscovered]),
        (id: "rare_flower_detection", name: "Rare Flower Detection", branch: Botany, max_level: 1, cost: 1,
         requires_skill: Some("flower_recognition"),
         description: "The region card counts the rare and very rare flowers still growing.",
         effects: [RareFlowerCounter]),
        (id: "collection_bonuses", name: "Collection Bonuses", branch: Botany, max_level: 1, cost: 2,
         requires_skill: Some("rare_flower_detection"),
         description: "+1 skill point once you have discovered every species growing on the farm.",
         effects: [CollectionSkillPoints]),
        // Floristry
        (id: "basic_florist", name: "Basic Florist", branch: Floristry, max_level: 2, cost: 1,
         description: "More XP for every bouquet you bind.",
         effects: [CraftXp(0.10)]),
        (id: "efficient_binding", name: "Efficient Binding", branch: Floristry, max_level: 2, cost: 1,
         requires_skill: Some("basic_florist"),
         description: "Bouquets bind faster.",
         effects: [CraftTime(0.10)]),
        (id: "artistic_arrangements", name: "Artistic Arrangements", branch: Floristry, max_level: 1, cost: 1,
         requires_skill: Some("efficient_binding"), requires_tool: Some("garden_scissors"),
         description: "Neatly trimmed stems: every bouquet sells for more.",
         effects: [BouquetPrice(0.05)]),
        (id: "premium_packaging", name: "Premium Packaging", branch: Floristry, max_level: 1, cost: 1,
         requires_skill: Some("artistic_arrangements"), requires_tool: Some("wrapping_paper_set"),
         description: "Wrapped bouquets sell for more.",
         effects: [BouquetPriceWithTool(tool: "wrapping_paper_set", bonus: 0.08)]),
        (id: "master_florist", name: "Master Florist", branch: Floristry, max_level: 1, cost: 2,
         requires_skill: Some("premium_packaging"), requires_tool: Some("florist_workbench"),
         description: "Bind ten more bouquets at once.",
         effects: [BatchCapacity(10)]),
        // Efficiency
        (id: "better_deals", name: "Better Deals", branch: Efficiency, max_level: 2, cost: 1,
         description: "Tools cost less.",
         effects: [ToolDiscount(0.04)]),
        (id: "thrifty_upgrades", name: "Reduced Upgrade Costs", branch: Efficiency, max_level: 3, cost: 1,
         requires_skill: Some("better_deals"),
         description: "Upgrades cost less.",
         effects: [UpgradeDiscount(0.04)]),
        (id: "improved_profits", name: "Improved Profits", branch: Efficiency, max_level: 3, cost: 1,
         requires_skill: Some("thrifty_upgrades"),
         description: "Every bouquet sells for more.",
         effects: [BouquetPrice(0.03)]),
        (id: "efficient_production", name: "Efficient Production", branch: Efficiency, max_level: 2, cost: 2,
         requires_skill: Some("improved_profits"),
         description: "A chance per bouquet that one of its flowers is saved and goes back in the basket.",
         effects: [FlowerSaver(0.05)]),
        // Exploration
        (id: "trailblazer", name: "Trailblazer", branch: Exploration, max_level: 2, cost: 1,
         description: "Walk and run faster along the furrows.",
         effects: [MoveSpeed(0.05)]),
        (id: "long_reach", name: "Long Reach", branch: Exploration, max_level: 2, cost: 1,
         requires_skill: Some("trailblazer"),
         description: "Pick flowers and aim tools from further away.",
         effects: [Reach(0.3)]),
        (id: "wide_rows", name: "Wide Rows", branch: Exploration, max_level: 1, cost: 2,
         requires_skill: Some("long_reach"), requires_tool: Some("advanced_harvesting_equipment"),
         description: "The flower cart gathers from a larger patch of beds.",
         effects: [AreaSize(0.15)]),
    ],

    // Optional goals. None is ever needed for the ending; rewards are small.
    achievements: [
        // Harvesting
        (id: "first_flower", name: "First Flower", category: Harvesting,
         description: "Pick your very first flower.",
         condition: FlowersHarvested(1), reward: (coins: 10)),
        (id: "hundred_flowers", name: "Armful", category: Harvesting,
         description: "Pick 100 flowers.",
         condition: FlowersHarvested(100), reward: (coins: 50)),
        (id: "thousand_flowers", name: "Field Hand", category: Harvesting,
         description: "Pick 1,000 flowers.",
         condition: FlowersHarvested(1000), reward: (skill_points: 1)),
        (id: "master_harvester", name: "Master Harvester", category: Harvesting,
         description: "Pick every flower on the farm.",
         condition: AllFlowersHarvested, reward: (coins: 200)),
        // Crafting
        (id: "first_bouquet", name: "First Bouquet", category: Crafting,
         description: "Bind your first bouquet.",
         condition: BouquetsCrafted(1), reward: (coins: 25)),
        (id: "ten_bouquets", name: "Busy Bench", category: Crafting,
         description: "Bind 10 bouquets.",
         condition: BouquetsCrafted(10), reward: (coins: 50)),
        (id: "hundred_bouquets", name: "Florist", category: Crafting,
         description: "Bind 100 bouquets.",
         condition: BouquetsCrafted(100), reward: (coins: 150)),
        (id: "grand_florist", name: "Grand Florist", category: Crafting,
         description: "Bind 500 bouquets.",
         condition: BouquetsCrafted(500), reward: (skill_points: 1)),
        // Exploration
